$C = "../../Common.ui";

// Estilo de botão do menu usando SecondaryButtonStyle do Common
@MenuButtonStyle = ButtonStyle(
    Default: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Secondary.png", Border: 12)),
    Hovered: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Secondary_Hovered.png", Border: 12)),
    Pressed: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Secondary_Pressed.png", Border: 12)),
    Disabled: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Disabled.png", Border: 12)),
    Sounds: $C.@ButtonSounds
);

@MenuButtonLabelStyle = LabelStyle(
    FontSize: 14,
    TextColor: #bfcdd5,
    RenderBold: true,
    RenderUppercase: true,
    HorizontalAlignment: Center,
    VerticalAlignment: Center
);

@MenuIconLabelStyle = LabelStyle(
    FontSize: 24,
    TextColor: #96a9be,
    HorizontalAlignment: Center,
    VerticalAlignment: Center
);

@InfoLabelStyle = LabelStyle(
    FontSize: 13,
    TextColor: #96a9be,
    VerticalAlignment: Center
);

$C.@PageOverlay {
    LayoutMode: Middle;

    $C.@DecoratedContainer {
        @CloseButton = true;
        Anchor: (Width: 420, Height: 480);

        #Title {
            $C.@Title { @Text = "MENU DA ILHA"; }
        }

        #Content {
            LayoutMode: Top;
            Padding: (Full: 17, Top: 12);

            // Informações da ilha no topo
            Group #IslandInfo {
                LayoutMode: Left;
                Anchor: (Height: 36);
                Background: (TexturePath: "../../Common/InputBox.png", Border: 16);
                Padding: (Horizontal: 12);

                Label #IslandNameLabel {
                    FlexWeight: 1;
                    Style: (
                        ...@InfoLabelStyle,
                        TextColor: #b7cedd
                    );
                    Text: "Sua Ilha";
                }

                Label #IslandLevelLabel {
                    Anchor: (Width: 80);
                    Style: (
                        ...@InfoLabelStyle,
                        TextColor: #7ed56f,
                        RenderBold: true,
                        HorizontalAlignment: End
                    );
                    Text: "Nível 1";
                }
            }

            // Separador
            $C.@PanelSeparatorFancy {
                @Anchor = (Top: 12, Bottom: 12);
            }

            // Grid de botões - Linha 1
            Group #Row1 {
                LayoutMode: Left;
                Anchor: (Height: 90, Bottom: 10);

                Button #IslandButton {
                    FlexWeight: 1;
                    Anchor: (Right: 8, Height: 90);
                    Style: @MenuButtonStyle;

                    Group {
                        LayoutMode: Top;
                        Padding: (Top: 18);

                        Group {
                            Text: "🏝";
                            Anchor: (Height: 32);
                            Style: @MenuIconLabelStyle;
                        }

                        Label {
                            Text: "ILHA";
                            Anchor: (Height: 28, Top: 4);
                            Style: @MenuButtonLabelStyle;
                        }
                    }
                }

                Button #QuestsButton {
                    FlexWeight: 1;
                    Anchor: (Right: 8, Height: 90);
                    Style: @MenuButtonStyle;

                    Group {
                        LayoutMode: Top;
                        Padding: (Top: 18);

                        Label {
                            Text: "📜";
                            Anchor: (Height: 32);
                            Style: @MenuIconLabelStyle;
                        }

                        Label {
                            Text: "QUESTS";
                            Anchor: (Height: 28, Top: 4);
                            Style: @MenuButtonLabelStyle;
                        }
                    }
                }

                Button #MarketButton {
                    FlexWeight: 1;
                    Anchor: (Height: 90);
                    Style: @MenuButtonStyle;

                    Group {
                        LayoutMode: Top;
                        Padding: (Top: 18);

                        Label {
                            Text: "💰";
                            Anchor: (Height: 32);
                            Style: @MenuIconLabelStyle;
                        }

                        Label {
                            Text: "MARKET";
                            Anchor: (Height: 28, Top: 4);
                            Style: @MenuButtonLabelStyle;
                        }
                    }
                }
            }

            // Grid de botões - Linha 2
            Group #Row2 {
                LayoutMode: Left;
                Anchor: (Height: 90, Bottom: 10);

                Button #SkillsButton {
                    FlexWeight: 1;
                    Anchor: (Right: 8, Height: 90);
                    Style: @MenuButtonStyle;

                    Group {
                        LayoutMode: Top;
                        Padding: (Top: 18);

                        Label {
                            Text: "⚔";
                            Anchor: (Height: 32);
                            Style: @MenuIconLabelStyle;
                        }

                        Label {
                            Text: "SKILLS";
                            Anchor: (Height: 28, Top: 4);
                            Style: @MenuButtonLabelStyle;
                        }
                    }
                }

                Button #ProfileButton {
                    FlexWeight: 1;
                    Anchor: (Right: 8, Height: 90);
                    Style: @MenuButtonStyle;

                    Group {
                        LayoutMode: Top;
                        Padding: (Top: 18);

                        Label {
                            Text: "👤";
                            Anchor: (Height: 32);
                            Style: @MenuIconLabelStyle;
                        }

                        Label {
                            Text: "PERFIL";
                            Anchor: (Height: 28, Top: 4);
                            Style: @MenuButtonLabelStyle;
                        }
                    }
                }

                Button #FriendsButton {
                    FlexWeight: 1;
                    Anchor: (Height: 90);
                    Style: @MenuButtonStyle;

                    Group {
                        LayoutMode: Top;
                        Padding: (Top: 18);

                        Label {
                            Text: "👥";
                            Anchor: (Height: 32);
                            Style: @MenuIconLabelStyle;
                        }

                        Label {
                            Text: "AMIGOS";
                            Anchor: (Height: 28, Top: 4);
                            Style: @MenuButtonLabelStyle;
                        }
                    }
                }
            }

            // Separador antes das ações
            $C.@ContentSeparator {
                @Anchor = (Top: 8, Bottom: 12);
            }

            // Botões de ação no rodapé
            Group #ActionButtons {
                LayoutMode: Left;
                Anchor: (Height: 44);

                $C.@SecondaryTextButton #TeleportButton {
                    @Text = "TELEPORTAR";
                    FlexWeight: 1;
                    Anchor: (Right: 8, Height: 44);
                }

                $C.@TertiaryTextButton #SettingsButton {
                    @Text = "CONFIG";
                    Anchor: (Width: 150, Height: 44);
                }
            }
        }
    }
}
