$C = "../../Common.ui";

// Estilo de botão do menu usando SecondaryButtonStyle do Common
@MenuButtonStyle = ButtonStyle(
    Default: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Secondary.png", Border: 12)),
    Hovered: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Secondary_Hovered.png", Border: 12)),
    Pressed: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Secondary_Pressed.png", Border: 12)),
    Disabled: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Disabled.png", Border: 12)),
    Sounds: $C.@ButtonSounds
);

@MenuButtonLabelStyle = LabelStyle(
    FontSize: 12,
    TextColor: #bfcdd5,
    RenderBold: true,
    RenderUppercase: true,
    HorizontalAlignment: Center,
    VerticalAlignment: Center
);

@InfoLabelStyle = LabelStyle(
    FontSize: 13,
    TextColor: #96a9be,
    VerticalAlignment: Center
);

$C.@PageOverlay {
    LayoutMode: Middle;

    $C.@DecoratedContainer {
        @CloseButton = true;
        Anchor: (Width: 500, Height: 700);

        #Title {
            $C.@Title { @Text = "Menu SkyBlock - Orion Network"; }
        }

        #Content {
            LayoutMode: Top;
            Padding: (Full: 15, Top: 10);

            // Informações da ilha no topo
            Group #IslandInfo {
                LayoutMode: Left;
                Anchor: (Height: 32);
                Background: (TexturePath: "../../Common/InputBox.png", Border: 16);
                Padding: (Horizontal: 12);

                Label #IslandNameLabel {
                    FlexWeight: 1;
                    Style: (
                        ...@InfoLabelStyle,
                        TextColor: #b7cedd
                    );
                    Text: "Sua Ilha";
                }

                Label #IslandLevelLabel {
                    Anchor: (Width: 70);
                    Style: (
                        ...@InfoLabelStyle,
                        TextColor: #7ed56f,
                        RenderBold: true,
                        HorizontalAlignment: End
                    );
                    Text: "Nível 1";
                }
            }

            // Separador
            $C.@ContentSeparator {
                @Anchor = (Top: 10, Bottom: 10);
            }

            // Grid de botões - Linha 1: Copper e Gold
            Group #Row1 {
                LayoutMode: Left;
                Anchor: (Bottom: 8);

                Button #CopperButton {
                    FlexWeight: 1;
                    Anchor: (Right: 8);
                    Style: @MenuButtonStyle;

                    Group {
                        LayoutMode: Top;
                        Padding: (Top: 8, Bottom: 8);

                        Group {
                            Anchor: (Width: 50, Height: 50);
                            Background: (TexturePath: "../../Common/Buttons/Tertiary.png", Border: 16);

                            ItemIcon {
                                ItemId: "Teleporter";
                                Anchor: (Width: 40, Height: 40);
                            }
                        }

                        Label {
                            Text: "Spawn";
                            Anchor: (Top: 4);
                            Style: (
                                ...@MenuButtonLabelStyle,
                                FontSize: 12,
                                TextColor: #ff6b6b
                            );
                        }

                        Label {
                            Text: "Volte ao início";
                            Anchor: (Top: 4);
                            Style: (
                                ...@MenuButtonLabelStyle,
                                FontSize: 10,
                                TextColor: #9aafc8
                            );
                        }
                    }
                }

                Button #GoldButton {
                    FlexWeight: 1;
                    Style: @MenuButtonStyle;

                    Group {
                        LayoutMode: Top;
                        Padding: (Top: 8, Bottom: 8);

                        Group {
                            Anchor: (Width: 50, Height: 50);
                            Background: (TexturePath: "../../Common/Buttons/Tertiary.png", Border: 16);

                            ItemIcon {
                                ItemId: "Plant_Crop_Apple_Block";
                                Anchor: (Width: 40, Height: 40);
                            }
                        }

                        Label {
                            Text: "Ilhas";
                            Anchor: (Top: 4);
                            Style: (
                                ...@MenuButtonLabelStyle,
                                FontSize: 12,
                                TextColor: #ffd93d
                            );
                        }

                        Label {
                            Text: "Gerencie suas ilhas";
                            Anchor: (Top: 4);
                            Style: (
                                ...@MenuButtonLabelStyle,
                                FontSize: 10,
                                TextColor: #9aafc8
                            );
                        }
                    }
                }
            }

            // Grid de botões - Linha 2: Iron e Coal
            Group #Row2 {
                LayoutMode: Left;
                Anchor: (Bottom: 8);

                Button #IronButton {
                    FlexWeight: 1;
                    Anchor: (Right: 8);
                    Style: @MenuButtonStyle;

                    Group {
                        LayoutMode: Top;
                        Padding: (Top: 8, Bottom: 8);

                        Group {
                            Anchor: (Width: 50, Height: 50);
                            Background: (TexturePath: "../../Common/Buttons/Tertiary.png", Border: 16);

                            ItemIcon {
                                ItemId: "Ingredient_Bolt_Cindercloth";
                                Anchor: (Width: 40, Height: 40);
                            }
                        }

                        Label {
                            Text: "Quests";
                            Anchor: (Top: 4);
                            Style: (
                                ...@MenuButtonLabelStyle,
                                FontSize: 12,
                                TextColor: #4ecdc4
                            );
                        }

                        Label {
                            Text: "Complete missões";
                            Anchor: (Top: 4);
                            Style: (
                                ...@MenuButtonLabelStyle,
                                FontSize: 10,
                                TextColor: #9aafc8
                            );
                        }
                    }
                }

                Button #CoalButton {
                    FlexWeight: 1;
                    Style: @MenuButtonStyle;

                    Group {
                        LayoutMode: Top;
                        Padding: (Top: 8, Bottom: 8);

                        Group {
                            Anchor: (Width: 50, Height: 50);
                            Background: (TexturePath: "../../Common/Buttons/Tertiary.png", Border: 16);

                            ItemIcon {
                                ItemId: "Deco_Trophy_Harvest";
                                Anchor: (Width: 40, Height: 40);
                            }
                        }

                        Label {
                            Text: "Amigos";
                            Anchor: (Top: 4);
                            Style: (
                                ...@MenuButtonLabelStyle,
                                FontSize: 12,
                                TextColor: #a8e6cf
                            );
                        }

                        Label {
                            Text: "Conecte-se com outros";
                            Anchor: (Top: 4);
                            Style: (
                                ...@MenuButtonLabelStyle,
                                FontSize: 10,
                                TextColor: #9aafc8
                            );
                        }
                    }
                }
            }

            // Grid de botões - Linha 3: Mithril e Silver
            Group #Row3 {
                LayoutMode: Left;

                Button #EconomyButton {
                    FlexWeight: 1;
                    Anchor: (Right: 8);
                    Style: @MenuButtonStyle;

                    Group {
                        LayoutMode: Top;
                        Padding: (Top: 8, Bottom: 8);

                        Group {
                            Anchor: (Width: 50, Height: 50);
                            Background: (TexturePath: "../../Common/Buttons/Tertiary.png", Border: 16);

                            ItemIcon {
                                ItemId: "Ingredient_Powder_Boom";
                                Anchor: (Width: 40, Height: 40);
                            }
                        }

                        Label {
                            Text: "Economia";
                            Anchor: (Top: 4);
                            Style: (
                                ...@MenuButtonLabelStyle,
                                FontSize: 12,
                                TextColor: #f3d06f
                            );
                        }

                        Label {
                            Text: "Acompanhe suas finanças";
                            Anchor: (Top: 4);
                            Style: (
                                ...@MenuButtonLabelStyle,
                                FontSize: 10,
                                TextColor: #9aafc8
                            );
                        }
                    }
                }

                Button #RankingButton {
                    FlexWeight: 1;
                    Style: @MenuButtonStyle;

                    Group {
                        LayoutMode: Top;
                        Padding: (Top: 8, Bottom: 8);

                        Group {
                            Anchor: (Width: 50, Height: 50);
                            Background: (TexturePath: "../../Common/Buttons/Tertiary.png", Border: 16);

                            ItemIcon {
                                ItemId: "Bench_Memories";
                                Anchor: (Width: 40, Height: 40);
                            }
                        }

                        Label {
                            Text: "Ranking";
                            Anchor: (Top: 4);
                            Style: (
                                ...@MenuButtonLabelStyle,
                                FontSize: 12,
                                TextColor: #32f366
                            );
                        }

                        Label {
                            Text: "Conquiste posições";
                            Anchor: (Top: 4);
                            Style: (
                                ...@MenuButtonLabelStyle,
                                FontSize: 10,
                                TextColor: #9aafc8
                            );
                        }
                    }
                }
            }

            // Separador antes das ações
            $C.@ContentSeparator {
                @Anchor = (Top: 10, Bottom: 10);
            }

            // Botões de ação no rodapé
            Group #ActionButtons {
                LayoutMode: Left;
                Anchor: (Height: 40);

                $C.@SecondaryTextButton #TeleportButton {
                    @Text = "TELEPORTAR";
                    FlexWeight: 1;
                    Anchor: (Right: 8, Height: 40);
                }

                $C.@TertiaryTextButton #CloseButtonAction {
                    @Text = "FECHAR";
                    Anchor: (Width: 100, Height: 40);
                }
            }
        }
    }
}
