$C = "../../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
    @CloseButton = true;
    Anchor: (Width: 450, Height: 500);

    #Title {
        $C.@Title { @Text = "CONVIDAR MEMBROS"; }
    }

    #Content {
        LayoutMode: Top;
        Padding: (Full: 15, Top: 10);

        // Input group
        Group #InputGroup {
            LayoutMode: Left;
            Anchor: (Bottom: 10, Height: 40);

            $C.@TextField #NameInput {
                FlexWeight: 1;
                Anchor: (Right: 8, Height: 40);
                PlaceholderText: "Digite o nome do jogador";
            }

            $C.@TextButton #InviteByNameButton {
                @Text = "CONVIDAR";
                Anchor: (Width: 160, Height: 40);
            }
        }

        // Separador
        $C.@ContentSeparator {
            Anchor: (Bottom: 10, Top: 10);
        }

        // Lista de jogadores online
        Group #PlayerList {
            LayoutMode: TopScrolling;
            Anchor: (Height: 350);
            // Entries will be appended here
        }
    }
}

$C.@BackButton {}
