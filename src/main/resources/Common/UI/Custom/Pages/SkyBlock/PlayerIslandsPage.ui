$C = "../../Common.ui";

// Estilo de botão do menu usando SecondaryButtonStyle do Common
@MenuButtonStyle = ButtonStyle(
    Default: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Secondary.png", Border: 12)),
    Hovered: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Secondary_Hovered.png", Border: 12)),
    Pressed: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Secondary_Pressed.png", Border: 12)),
    Disabled: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Primary.png", Border: 12)),
    Sounds: $C.@ButtonSounds
);

@InfoLabelStyle = LabelStyle(
    FontSize: 13,
    TextColor: #96a9be,
    VerticalAlignment: Center
);

$C.@PageOverlay {}

$C.@DecoratedContainer {
    @CloseButton = true;
    Anchor: (Width: 600, Height: 700);

    #Title {
        $C.@Title { @Text = "Suas Ilhas - Orion Network"; }
    }

    #Content {
        LayoutMode: Top;
        Padding: (Full: 15, Top: 10);

        Group {
            LayoutMode: Top;

            Group {
                LayoutMode: Top;

                Label {
                    Style: (
                        ...@InfoLabelStyle,
                        TextColor: #FFFFFF,
                        FontSize: 16,
                        RenderBold: true
                    );
                    Text: "Minhas Ilhas";
                    FlexWeight: 1;
                    Anchor: (Height: 30, Bottom: 10);
                    Padding: (Left: 10);
                    Background: (TexturePath: "../../Common/InputBox.png", Border: 16);
                }
            }

            // Grid 3x3 de ilhas
            Group #IslandsGrid {
                LayoutMode: Top;
                FlexWeight: 1;

                Group #EmptyState {
                    LayoutMode: Top;
                    FlexWeight: 1;
                    Visible: false;
                    Anchor: (Height: 250);
                    Padding: (Top: 75);

                    Label #ScrollingEmptyLabel {
                        Text: "Você ainda não possui uma ilha.";
                        Style: (
                            ...@InfoLabelStyle,
                            FontSize: 16,
                            HorizontalAlignment: Center,
                            VerticalAlignment: Center,
                            RenderItalics: true
                        );
                    }

                    $C.@TextButton #CreateIslandButton {
                        @Text = "Criar";
                        Anchor: (Width: 160, Height: 40, Top: 15);
                    }
                }


                Group #Islands {
                    LayoutMode: TopScrolling;
                    FlexWeight: 1;
                    Anchor: (Height: 250);
                    ScrollbarStyle: @DefaultScrollbarStyle;
                }
            }
        }

        Group {
            LayoutMode: Top;
            Anchor: (Top: 10);

            Group {
                LayoutMode: Top;

                Label {
                    Style: (
                        ...@InfoLabelStyle,
                        TextColor: #FFFFFF,
                        FontSize: 16,
                        RenderBold: true
                    );
                    Text: "Ilhas de Amigos";
                    FlexWeight: 1;
                    Anchor: (Height: 30, Bottom: 10);
                    Padding: (Left: 10);
                    Background: (TexturePath: "../../Common/InputBox.png", Border: 16);
                }
            }

            // Grid 3x3 de ilhas
            Group #IslandsGrid {
                LayoutMode: Top;
                FlexWeight: 1;

                Group #Islands {
                    LayoutMode: TopScrolling;
                    FlexWeight: 1;
                    Anchor: (Height: 250);
                    ScrollbarStyle: @DefaultScrollbarStyle;
                }
            }
        }
    }
}

$C.@BackButton {}
