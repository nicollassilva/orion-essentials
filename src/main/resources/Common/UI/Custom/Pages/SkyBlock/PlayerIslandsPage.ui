$C = "../../Common.ui";

// Estilo de botão do menu usando SecondaryButtonStyle do Common
@MenuButtonStyle = ButtonStyle(
    Default: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Secondary.png", Border: 12)),
    Hovered: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Secondary_Hovered.png", Border: 12)),
    Pressed: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Secondary_Pressed.png", Border: 12)),
    Disabled: (Background: PatchStyle(TexturePath: "../../Common/Buttons/Primary.png", Border: 12)),
    Sounds: $C.@ButtonSounds
);

@InfoLabelStyle = LabelStyle(
    FontSize: 13,
    TextColor: #96a9be,
    VerticalAlignment: Center
);

$C.@PageOverlay {
    LayoutMode: Middle;

    $C.@DecoratedContainer {
        @CloseButton = true;
        Anchor: (Width: 600, Height: 700);

        #Title {
            $C.@Title { @Text = "Suas Ilhas - Orion Network"; }
        }

        #Content {
            LayoutMode: Top;
            Padding: (Full: 15, Top: 10);

            // Grid 3x3 de ilhas
            Group #IslandsGrid {
                LayoutMode: Top;
                Anchor: (Height: 500);

                // Row 1
                Group #Row1 {
                    LayoutMode: Left;
                    Anchor: (Bottom: 10);

                    Button #Island1 {
                        Anchor: (Width: 180, Height: 120, Right: 10);
                        Style: @MenuButtonStyle;

                        Group {
                            LayoutMode: Top;
                            Padding: (Full: 10);

                            Group #LevelBox1 {
                                Anchor: (Width: 30, Height: 30);
                                Background: (TexturePath: "../../Common/Buttons/Primary.png", Border: 16);
                                Padding: (Full: 5);

                                Label #LevelLabel1 {
                                    Style: (
                                        ...@InfoLabelStyle,
                                        TextColor: #FFFFFF,
                                        HorizontalAlignment: Center,
                                        VerticalAlignment: Center,
                                        FontSize: 14,
                                        RenderBold: true
                                    );
                                    Text: "Lv. 1";
                                }
                            }

                            Label #NameLabel1 {
                                Anchor: (Top: 10);
                                Style: (
                                    ...@InfoLabelStyle,
                                    TextColor: #b7cedd,
                                    HorizontalAlignment: Center,
                                    FontSize: 16,
                                    RenderBold: true
                                );
                                Text: "Ilha 1";
                            }
                        }
                    }

                    Button #Island2 {
                        Anchor: (Width: 180, Height: 120, Right: 10);
