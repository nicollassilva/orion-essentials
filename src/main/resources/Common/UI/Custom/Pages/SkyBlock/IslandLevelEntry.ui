@InfoLabelStyle = LabelStyle(
    FontSize: 13,
    TextColor: #96a9be,
    VerticalAlignment: Center
);

Group {
    LayoutMode: Top;
    Anchor: (Bottom: 10);
    Background: (TexturePath: "../../Common/InputBox.png", Border: 16);
    Padding: (Full: 10);

    // Header: Level, Title, XP
    Group {
        LayoutMode: Left;
        Anchor: (Bottom: 10);

        Group {
            Anchor: (Width: 30, Height: 30);
            Background: (TexturePath: "../../Common/Buttons/Primary.png", Border: 16);

            Label #LevelLabel {
                Text: "1";
                Style: (
                    TextColor: #FFFFFF,
                    HorizontalAlignment: Center,
                    VerticalAlignment: Center,
                    FontSize: 16,
                    RenderBold: true
                );
            }
        }

        Label #TitleLabel {
            Text: "Título do Nível";
            Anchor: (Left: 10);
            Style: (
                TextColor: #b7cedd,
                FontSize: 16,
                RenderBold: true,
                VerticalAlignment: Center
            );
            FlexWeight: 1;
        }

        Label #XPRequiredLabel {
            Text: "XP: 100";
            Style: (
                TextColor: #7ed56f,
                FontSize: 14,
                HorizontalAlignment: End,
                RenderBold: true,
                VerticalAlignment: Center
            );
            Anchor: (Width: 120);
        }
    }

    // Icon and Description
    Group {
        LayoutMode: Left;
        Anchor: (Bottom: 10);

        Group {
            Anchor: (Width: 80, Height: 80);
            Background: (TexturePath: "../../Common/Buttons/Disabled.png", Border: 16);

            ItemIcon #LevelIcon {
                ItemId: "icon_level_1";
                Anchor: (Width: 60, Height: 60);
            }
        }

        Label #DescriptionLabel {
            Text: "Descrição do nível";
            Style: (
                ...@InfoLabelStyle,
                TextColor: #bfcdd5,
                FontSize: 13,
                VerticalAlignment: Start
            );
            FlexWeight: 1;
            Anchor: (Left: 15);
        }
    }

    // Rewards
    Group #RewardsGroup {
        LayoutMode: Right;

        Group #RewardsList {
            LayoutMode: Right;
            FlexWeight: 1;
        }
    }
}
