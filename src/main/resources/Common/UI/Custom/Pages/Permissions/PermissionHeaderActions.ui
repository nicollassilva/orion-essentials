$C = "../../Common.ui";

@PlayerListButtonStyle = ButtonStyle(
    Default: (Background: #1b2a45),
    Hovered: (Background: #223550),
    Pressed: (Background: #0f1a2e),
    Sounds: $C.@ButtonSounds
);

@DeletePermissionButtonStyle = ButtonStyle(
    Default: (Background: #ad2323),
    Hovered: (Background: #e31b1b),
    Pressed: (Background: #691717),
    Disabled: (Background: #555555),
    Sounds: $C.@ButtonSounds
);

@SaveButtonStyle = ButtonStyle(
    Default: (Background: #139c47),
    Hovered: (Background: #16c95a),
    Pressed: (Background: #0e7836),
    Disabled: (Background: #555555),
    Sounds: $C.@ButtonSounds
);

Group {
    LayoutMode: Left;

    Button #SeePlayers {
          LayoutMode: Top;
          Anchor: (Right: 5, Height: 30);
          Padding: (Full: 6);
          Style: @PlayerListButtonStyle;

          Label {
                Text: "Lista de Jogadores";
                Style: (
                      FontSize: 14,
                      RenderBold: true,
                      TextColor: #b6c9de
               );
         }
    }

    Button #DeletePermission {
          LayoutMode: Top;
          Anchor: (Right: 5, Height: 30);
          Padding: (Full: 6);
          Style: @DeletePermissionButtonStyle;

          Label {
                Text: "Deletar";
                Style: (
                      FontSize: 14,
                      RenderBold: true,
                      TextColor: #b6c9de
               );
         }
    }

    Button #SavePermission {
          LayoutMode: Top;
          Anchor: (Right: 5, Height: 30);
          Padding: (Full: 6);
          Style: @SaveButtonStyle;

          Label {
                Text: "Salvar";
                Style: (
                      FontSize: 14,
                      RenderBold: true,
                      TextColor: #b6c9de
               );
         }
    }
}