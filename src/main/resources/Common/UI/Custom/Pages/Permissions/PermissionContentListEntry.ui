$C = "../../Common.ui";

@DettachButtonStyle = ButtonStyle(
    Default: (Background: #ad2323),
    Hovered: (Background: #e31b1b),
    Pressed: (Background: #691717),
    Sounds: $C.@ButtonSounds
);

@EditButtonStyle = ButtonStyle(
    Default: (Background: #0023bb),
    Hovered: (Background: #1e5b99),
    Pressed: (Background: #0023bb),
    Sounds: $C.@ButtonSounds
);

@PermissionEntryStyle = ButtonStyle(
    Default: (Background: #000000(0.45)),
    Hovered: (Background: #000000(0.15))
);

Button {
    Anchor: (Height: 35, Bottom: 5);
    Style: @PermissionEntryStyle;

    Label {
        Padding: (Left: 15);
        Text: "multicommands.tell.*";
        Style: (
            FontSize: 14,
            TextColor: #FFFFFF,
            VerticalAlignment: Center
        );
    }

    Group {
        LayoutMode: Right;

        Group {
            LayoutMode: Right;

            Button #EditPermission {
              LayoutMode: Top;
              Padding: (Left: 5, Right: 5, Top: 3);
              Anchor: (Height: 25);
              Style: @EditButtonStyle;

              Label {
                Text: "Editar";
                Style: (
                  FontSize: 14,
                  RenderBold: true,
                  TextColor: #b6c9de
                );
              }
            }

            Button #DettachPermission {
                  LayoutMode: Top;
                  Padding: (Left: 5, Right: 5, Top: 3);
                  Anchor: (Left: 5, Height: 25);
                  Style: @DettachButtonStyle;

                  Label {
                        Text: "X";
                        Style: (
                              FontSize: 14,
                              RenderBold: true,
                              TextColor: #b6c9de,
                              VerticalAlignment: Center,
                              HorizontalAlignment: Center
                       );
                 }
            }
        }
    }
}