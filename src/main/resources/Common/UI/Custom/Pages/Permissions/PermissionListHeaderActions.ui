$C = "../../Common.ui";

@DettachPermissionButtonStyle = ButtonStyle(
    Default: (Background: #ad2323),
    Hovered: (Background: #e31b1b),
    Pressed: (Background: #691717),
    Sounds: $C.@ButtonSounds
);

@AttachButtonStyle = ButtonStyle(
    Default: (Background: #139c47),
    Hovered: (Background: #16c95a),
    Pressed: (Background: #0e7836),
    Sounds: $C.@ButtonSounds
);

Group {
    Anchor: (Height: 45, Bottom: 5);
    Background: #000000(0.45);

    Label {
        Padding: (Left: 15);
        Text: "Lista de Permissões";
        Style: (
            TextColor: #b6c9de,
            RenderBold: true,
            VerticalAlignment: Center
        );
    }

    Group {
        LayoutMode: Right;

        Group {
            LayoutMode: Left;

            Button #DettachPermission {
                  LayoutMode: Top;
                  Anchor: (Right: 5, Height: 30);
                  Padding: (Full: 6);
                  Style: @DettachPermissionButtonStyle;

                  Label {
                        Text: "Deletar";
                        Style: (
                              FontSize: 14,
                              RenderBold: true,
                              TextColor: #b6c9de
                       );
                 }
            }

            Button #AttachPermission {
                  LayoutMode: Top;
                  Anchor: (Right: 5, Height: 30);
                  Padding: (Full: 6);
                  Style: @AttachButtonStyle;

                  Label {
                        Text: "Vincular";
                        Style: (
                              FontSize: 14,
                              RenderBold: true,
                              TextColor: #b6c9de
                       );
                 }
            }
        }
    }
}